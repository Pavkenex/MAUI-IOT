<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MAUI_IOT.Models"
             xmlns:pageModels="clr-namespace:MAUI_IOT.PageModels"
             x:DataType="pageModels:HistoryPageModel"
             x:Class="MAUI_IOT.Pages.HistoryPage"
             BackgroundColor="{StaticResource AppBackground}"
             Title="History">
    <RefreshView IsRefreshing="{Binding IsBusy}"
                 Command="{Binding LoadHistoryCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16,16,16,28" Spacing="16">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Reading History"
                           Style="{StaticResource PageTitleLabel}" />
                    <Label Text="DHT22 readings stored locally from ESP32 devices"
                           Style="{StaticResource PageSubtitleLabel}" />
                </VerticalStackLayout>

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   HeightRequest="22" />

                <Label Text="{Binding ErrorMessage}"
                       TextColor="DarkRed"
                       IsVisible="{Binding HasError}" />

                <!-- Local storage summary -->
                <Border Style="{StaticResource DashboardCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Local Storage Summary"
                               TextColor="{StaticResource TextPrimary}"
                               FontSize="16"
                               FontAttributes="Bold" />
                        <Label Text="{Binding StorageSummary}"
                               TextColor="{StaticResource TextMuted}"
                               FontSize="13" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="READINGS"
                                       Style="{StaticResource MetricTitleLabel}" />
                                <Label Text="{Binding TotalReadings}"
                                       TextColor="{StaticResource TemperatureAccent}"
                                       FontSize="20"
                                       FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="DEVICES"
                                       Style="{StaticResource MetricTitleLabel}" />
                                <Label Text="{Binding TotalDevices}"
                                       TextColor="{StaticResource HumidityAccent}"
                                       FontSize="20"
                                       FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                <Label Text="PENDING"
                                       Style="{StaticResource MetricTitleLabel}" />
                                <Label Text="{Binding PendingUploads}"
                                       TextColor="{StaticResource GpsAccent}"
                                       FontSize="20"
                                       FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- No readings state -->
                <Border IsVisible="{Binding HasReadings, Converter={StaticResource InvertedBoolConverter}}"
                        Style="{StaticResource DashboardCard}">
                    <VerticalStackLayout Spacing="8" Padding="8">
                        <Label Text="No readings yet"
                               TextColor="{StaticResource TextMuted}"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Go to the Scan tab, connect to an ESP32 and synchronize readings."
                               TextColor="{StaticResource TextMuted}"
                               FontSize="13"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Reading list -->
                <CollectionView ItemsSource="{Binding Readings}"
                                IsVisible="{Binding HasReadings}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:EspReadingView">
                            <Border BackgroundColor="{StaticResource CardBackground}"
                                    Stroke="{StaticResource CardStroke}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="14"
                                    Margin="0,0,0,10">
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6" ColumnSpacing="12">
                                    <Label Grid.Row="0"
                                           Text="{Binding DeviceId}"
                                           TextColor="{StaticResource TextPrimary}"
                                           FontSize="15"
                                           FontAttributes="Bold" />

                                    <Border Grid.Row="0"
                                            Grid.Column="1"
                                            Style="{StaticResource DashboardBadge}"
                                            BackgroundColor="{StaticResource SoftNeutral}">
                                        <Label Text="{Binding IsUploaded, Converter={StaticResource BoolToUploadStatusConverter}}"
                                               TextColor="{StaticResource TextMuted}"
                                               FontSize="10"
                                               FontAttributes="Bold" />
                                    </Border>

                                    <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="14">
                                        <Label Text="{Binding TemperatureCelsius, StringFormat='{0:F1}°C'}"
                                               TextColor="{StaticResource TemperatureAccent}"
                                               FontSize="14"
                                               FontAttributes="Bold" />
                                        <Label Text="{Binding HumidityPercent, StringFormat='{0:F1}%'}"
                                               TextColor="{StaticResource HumidityPurple}"
                                               FontSize="14"
                                               FontAttributes="Bold" />
                                        <Label Text="{Binding ReadingId, StringFormat='Reading {0}'}"
                                               TextColor="{StaticResource TextMuted}"
                                               FontSize="12" />
                                    </HorizontalStackLayout>

                                    <Label Grid.Row="2"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding RecordedAtLocal, StringFormat='{0:yyyy-MM-dd HH:mm:ss}'}"
                                           TextColor="{StaticResource TextMuted}"
                                           FontSize="11" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
