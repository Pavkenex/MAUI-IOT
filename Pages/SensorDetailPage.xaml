<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MAUI_IOT.Models"
             x:Class="MAUI_IOT.Pages.SensorDetailPage"
             Title="Sensor details">

    <Grid Padding="20" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="16">
        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}" />

        <Label Grid.Row="1"
               Text="{Binding ErrorMessage}"
               TextColor="DarkRed" />

        <Border Grid.Row="2" Padding="18" StrokeThickness="1">
            <VerticalStackLayout Spacing="10">
                <Label Text="{Binding Sensor.Name}" FontSize="28" FontAttributes="Bold" />
                <Label Text="{Binding Sensor.Type, StringFormat='Type: {0}'}" />
                <Label Text="{Binding Sensor.LatestReading, StringFormat='Latest reading: {0}'}" FontSize="20" />
                <Label Text="{Binding Sensor.IsOnline, StringFormat='Online: {0}'}" />
            </VerticalStackLayout>
        </Border>
        
        <VerticalStackLayout Grid.Row="3" Spacing="8">
            <Label Text="Recent readings" FontSize="20" FontAttributes="Bold" />
            <CollectionView ItemsSource="{Binding Readings}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Reading">
                        <Border Margin="0,0,0,8" Padding="14" StrokeThickness="1">
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                <Label Text="{Binding Value}" FontSize="18" />
                                <Label Grid.Column="1" Text="{Binding Timestamp, StringFormat='{0:HH:mm}'}" TextColor="Gray"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
