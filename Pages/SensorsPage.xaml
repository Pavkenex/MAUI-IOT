<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MAUI_IOT.Models"
             xmlns:pageModels="clr-namespace:MAUI_IOT.PageModels"
              x:DataType="pageModels:SensorsPageModel"
              x:Class="MAUI_IOT.Pages.SensorsPage"
              Title="Sensors">
    <Grid Padding="20" RowDefinitions ="Auto, Auto, Auto, *" RowSpacing="16">
        <VerticalStackLayout Spacing="4">
            <Label Text="IoT Sensors" FontSize="32" FontAttributes="Bold" />
            <Label Text="Mock data now. TODO API later"/>
        </VerticalStackLayout>
        <Button Grid.Row="1" Text="Refresh Sensors" Command="{Binding LoadSensorsCommand}" />
            <ActivityIndicator Grid.Row="2" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
        <Label Grid.Row="2" Text="{Binding ErrorMessage}" TextColor="DarkRed" IsVisible="{Binding HasError}" />
        <Label Grid.Row="3" Text="No sensors available." IsVisible="{Binding IsEmpty}" HorizontalOptions="Center" VerticalOptions="Center" TextColor="Gray" />
        <CollectionView Grid.Row="3" ItemsSource="{Binding Sensors}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:SensorSummary">
                    <Border Margin="0,0,0,12" Padding="16" StrokeThickness="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenSensorCommand}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Name}" FontSize="20" FontAttributes="Bold" />
                            <Label Text="{Binding Type}" TextColor="Gray"   />
                            <Label Text="{Binding LatestReading}" FontSize="18"/>
                            <Label Text="{Binding IsOnline, StringFormat='Online: {0}'}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        
        
        
    </Grid>
</ContentPage>
