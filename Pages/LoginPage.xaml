<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUI_IOT.Pages.LoginPage"
             BackgroundColor="{StaticResource AppBackground}"
             Shell.TabBarIsVisible="False"
             Shell.NavBarIsVisible="False"
             Title="Sign in">
    <ScrollView>
        <VerticalStackLayout Padding="20,48,20,24"
                             Spacing="18"
                             VerticalOptions="Center"
                             MaximumWidthRequest="420">
            <VerticalStackLayout Spacing="6">
                <Label Text="MAUI &amp; IOT"
                       Style="{StaticResource PageTitleLabel}"
                       HorizontalTextAlignment="Center" />
                <Label Text="Sign in to sync your readings to the cloud"
                       Style="{StaticResource PageSubtitleLabel}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <Border Style="{StaticResource DashboardCard}">
                <VerticalStackLayout Spacing="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="USERNAME" Style="{StaticResource MetricTitleLabel}" />
                        <Border Style="{StaticResource AuthFieldBorder}">
                            <Entry Style="{StaticResource AuthEntry}"
                                   Text="{Binding Username}"
                                   Placeholder="username"
                                   IsSpellCheckEnabled="False"
                                   IsTextPredictionEnabled="False"
                                   ReturnType="Next" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="PASSWORD" Style="{StaticResource MetricTitleLabel}" />
                        <Border Style="{StaticResource AuthFieldBorder}">
                            <Entry Style="{StaticResource AuthEntry}"
                                   Text="{Binding Password}"
                                   Placeholder="password"
                                   IsPassword="True"
                                   ReturnType="Go" />
                        </Border>
                    </VerticalStackLayout>

                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding HasError}"
                           TextColor="{StaticResource WarningText}"
                           FontSize="13" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       HeightRequest="22" />

                    <Button Text="Sign in"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"
                            MinimumHeightRequest="50" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Create an account"
                    Command="{Binding GoToRegisterCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource GpsAccent}"
                    FontAttributes="Bold"
                    MinimumHeightRequest="44" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
