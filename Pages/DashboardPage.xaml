<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="MAUI_IOT.Pages.DashboardPage"
             BackgroundColor="{StaticResource AppBackground}"
             Title="Dashboard">
    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding LoadDashboardCommand}"
                 RefreshColor="{StaticResource GpsAccent}">
        <ScrollView>
            <VerticalStackLayout Padding="16,16,16,28" Spacing="16">
                <Grid MaximumWidthRequest="{OnIdiom Desktop=1400, Default=100000}"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="ESP Readings Dashboard" Style="{StaticResource PageTitleLabel}" />
                            <Label Text="{Binding LastUpdated}" Style="{StaticResource PageSubtitleLabel}" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="Refresh"
                                Command="{Binding LoadDashboardCommand}"
                                MinimumHeightRequest="44"
                                Padding="14,8"
                                VerticalOptions="Center" />
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                            <Label Text="ACCOUNT" Style="{StaticResource MetricTitleLabel}" />
                            <Label Text="{Binding AccountName}"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>

                        <Button Grid.Column="1"
                                Text="Sign out"
                                Command="{Binding LogoutCommand}"
                                IsVisible="{Binding IsSignedIn}"
                                MinimumHeightRequest="40"
                                Padding="14,6"
                                VerticalOptions="Center" />

                        <Button Grid.Column="1"
                                Text="Sign in"
                                Command="{Binding SignInCommand}"
                                IsVisible="{Binding IsSignedIn, Converter={StaticResource InvertedBoolConverter}}"
                                MinimumHeightRequest="40"
                                Padding="14,6"
                                VerticalOptions="Center" />
                    </Grid>
                </Grid>

                <VerticalStackLayout Spacing="8"
                                     MaximumWidthRequest="{OnIdiom Desktop=1400, Default=100000}">
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       HeightRequest="22" />

                    <Label Text="{Binding ErrorMessage}"
                           TextColor="DarkRed"
                           IsVisible="{Binding HasError}" />
                </VerticalStackLayout>

                <Border BackgroundColor="{StaticResource GpsCardBackground}"
                        Stroke="#B8CCE8"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="20">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12"
                              MaximumWidthRequest="{OnIdiom Desktop=1400, Default=100000}">
                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                <Label Text="⌖"
                                       FontSize="26"
                                       TextColor="{StaticResource GpsAccent}"
                                       VerticalOptions="Center" />

                                <Label Text="Last Reading"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       LineBreakMode="TailTruncation"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <Border Grid.Column="1"
                                    Style="{StaticResource DashboardBadge}"
                                    BackgroundColor="White"
                                    MaximumWidthRequest="150"
                                    VerticalOptions="Center">
                                <Label Text="{Binding LatestDeviceId}"
                                       TextColor="{StaticResource GpsAccent}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,1,Auto"
                              ColumnSpacing="24"
                              RowSpacing="6"
                              HorizontalOptions="Center"
                              MaximumWidthRequest="{OnIdiom Desktop=1400, Default=100000}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="TEMPERATURE" Style="{StaticResource MetricTitleLabel}" />
                                <Label Text="{Binding Temperature}"
                                       TextColor="{StaticResource TemperatureAccent}"
                                       FontSize="24"
                                       FontAttributes="Bold" />
                            </VerticalStackLayout>

                            <BoxView Grid.Column="1"
                                     WidthRequest="1"
                                     Color="#B8CCE8"
                                     VerticalOptions="Fill" />

                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                <Label Text="HUMIDITY" Style="{StaticResource MetricTitleLabel}" />
                                <Label Text="{Binding Humidity}"
                                       TextColor="{StaticResource HumidityPurple}"
                                       FontSize="24"
                                       FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Grid>

                        <Border BackgroundColor="White"
                                Stroke="#B8CCE8"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="0"
                                HeightRequest="{OnIdiom Desktop=520, Default=190}">
                            <Grid>
                                <WebView x:Name="MapWebView"
                                         Source="{Binding MapSource}"
                                         UserAgent="MauiIot/1.0"
                                         IsVisible="{Binding HasLatestLocation}"
                                         Navigating="OnMapNavigating" />

                                <VerticalStackLayout IsVisible="{Binding HasLatestLocation, Converter={StaticResource InvertedBoolConverter}}"
                                                     Spacing="8"
                                                     VerticalOptions="Center"
                                                     Padding="20">
                                    <Label Text="No location for this measurement"
                                           TextColor="{StaticResource MapPlaceholder}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center" />
                                    <Label Text="Location is captured from this phone when readings are received from the ESP."
                                           TextColor="{StaticResource TextMuted}"
                                           FontSize="12"
                                           HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource DashboardCard}"
                        MaximumWidthRequest="{OnIdiom Desktop=1400, Default=100000}">
                    <VerticalStackLayout Spacing="16">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding TrendTitle}"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="22"
                                   FontAttributes="Bold" />

                            <Label Text="{Binding TrendSubtitle}"
                                   Style="{StaticResource PageSubtitleLabel}" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="8"
                              MaximumWidthRequest="{OnIdiom Desktop=380, Default=100000}"
                              HorizontalOptions="{OnIdiom Desktop=Start, Default=Fill}"
                              IsVisible="{Binding Trend.HasData}">
                            <Button Text="Temperature"
                                    Command="{Binding Trend.SelectTemperatureCommand}"
                                    BackgroundColor="{StaticResource SoftNeutral}"
                                    TextColor="{StaticResource TextPrimary}"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    MinimumHeightRequest="40"
                                    Padding="12,6"
                                    CornerRadius="10">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding Trend.IsTemperatureSelected}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource TemperatureAccent}" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Grid.Column="1"
                                    Text="Humidity"
                                    Command="{Binding Trend.SelectHumidityCommand}"
                                    BackgroundColor="{StaticResource SoftNeutral}"
                                    TextColor="{StaticResource TextPrimary}"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    MinimumHeightRequest="40"
                                    Padding="12,6"
                                    CornerRadius="10">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button"
                                                 Binding="{Binding Trend.IsHumiditySelected}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource HumidityPurple}" />
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>

                        <lvc:CartesianChart IsVisible="{Binding Trend.HasData}"
                                            HeightRequest="{OnIdiom Desktop=320, Default=236}"
                                            Series="{Binding Trend.Series}"
                                            XAxes="{Binding Trend.XAxes}"
                                            YAxes="{Binding Trend.YAxes}"
                                            LegendPosition="Bottom"
                                            TooltipPosition="Top"
                                            LegendTextSize="12"
                                            TooltipTextSize="12"
                                            LegendTextPaint="{Binding Trend.LegendTextPaint}"
                                            TooltipTextPaint="{Binding Trend.TooltipTextPaint}"
                                            TooltipBackgroundPaint="{Binding Trend.TooltipBackgroundPaint}"
                                            DataPointerDown="OnTrendDataPointerDown" />

                        <Label Text="No readings yet"
                               IsVisible="{Binding Trend.HasData, Converter={StaticResource InvertedBoolConverter}}"
                               TextColor="{StaticResource TextMuted}"
                               FontSize="14"
                               HorizontalTextAlignment="Center"
                               Padding="0,24" />

                        <Border IsVisible="{Binding Trend.HasSelection}"
                                BackgroundColor="{StaticResource SoftNeutral}"
                                Stroke="{StaticResource CardStroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="14">
                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto,Auto,Auto"
                                  ColumnSpacing="10"
                                  RowSpacing="4">
                                <Label Text="{Binding Trend.SelectedDeviceName}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation" />

                                <Button Grid.Column="1"
                                        Text="×"
                                        Command="{Binding Trend.DismissSelectionCommand}"
                                        BackgroundColor="Transparent"
                                        TextColor="{StaticResource TextMuted}"
                                        FontSize="16"
                                        Padding="8,0"
                                        MinimumHeightRequest="32"
                                        MinimumWidthRequest="32" />

                                <Label Grid.Row="1"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding Trend.SelectedValueText}"
                                       TextColor="{StaticResource TemperatureAccent}"
                                       FontSize="22"
                                       FontAttributes="Bold">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding Trend.IsHumiditySelected}"
                                                     Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource HumidityPurple}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <Label Grid.Row="2"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding Trend.SelectedTimeText}"
                                       TextColor="{StaticResource TextMuted}"
                                       FontSize="12" />

                                <Grid Grid.Row="3"
                                      Grid.ColumnSpan="2"
                                      ColumnDefinitions="*,Auto"
                                      ColumnSpacing="10">
                                    <Label Text="{Binding Trend.SelectedLocationText}"
                                           TextColor="{StaticResource TextMuted}"
                                           FontSize="12"
                                           VerticalOptions="Center" />

                                    <Button Grid.Column="1"
                                            Text="View device"
                                            Command="{Binding Trend.ViewDeviceCommand}"
                                            MinimumHeightRequest="36"
                                            Padding="12,4"
                                            FontSize="12" />
                                </Grid>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
