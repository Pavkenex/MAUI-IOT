<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MAUI_IOT.Models"
             xmlns:pageModels="clr-namespace:MAUI_IOT.PageModels"
             x:DataType="pageModels:SyncPageModel"
             x:Class="MAUI_IOT.Pages.SyncPage"
             BackgroundColor="{StaticResource AppBackground}"
             Title="Sync">
    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,28" Spacing="16">
            <VerticalStackLayout Spacing="2">
                <Label Text="Device Sync"
                       Style="{StaticResource PageTitleLabel}" />
                <Label Text="Connect to the ESP32 and download stored DHT22 readings"
                       Style="{StaticResource PageSubtitleLabel}" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HeightRequest="22" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="DarkRed"
                   IsVisible="{Binding HasError}" />

            <!-- Device card -->
            <Border Style="{StaticResource SensorCard}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Device.Name, TargetNullValue='No device selected'}"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="18"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding Device.Address, TargetNullValue='Run a scan and select an ESP device'}"
                                   TextColor="{StaticResource TextMuted}"
                                   FontSize="13" />
                        </VerticalStackLayout>

                        <Border Grid.Column="1"
                                Style="{StaticResource DashboardBadge}"
                                BackgroundColor="{StaticResource SoftBlue}">
                            <Label Text="{Binding DeviceStatusText}"
                                   TextColor="{StaticResource TemperatureAccent}"
                                   FontSize="11"
                                   FontAttributes="Bold" />
                        </Border>
                    </Grid>

                    <Label Text="{Binding StatusMessage}"
                           TextColor="{StaticResource TextMuted}"
                           FontSize="14" />

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Button Text="Connect"
                                Command="{Binding ConnectCommand}"
                                IsEnabled="{Binding CanConnect}" />

                        <Button Grid.Column="1"
                                Text="Sync"
                                Command="{Binding SyncCommand}"
                                IsEnabled="{Binding CanSync}" />

                        <Button Grid.Column="2"
                                Text="Disconnect"
                                Command="{Binding DisconnectCommand}"
                                IsEnabled="{Binding CanDisconnect}" />
                    </Grid>

                    <Button Text="Cancel Synchronization"
                            Command="{Binding CancelSyncCommand}"
                            IsEnabled="{Binding CanCancelSync}" />
                </VerticalStackLayout>
            </Border>

            <!-- Progress -->
            <Border IsVisible="{Binding IsSyncing}"
                    Style="{StaticResource DashboardCard}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Synchronization in progress"
                           TextColor="{StaticResource TextPrimary}"
                           FontSize="16"
                           FontAttributes="Bold" />
                    <Label Text="{Binding ProgressText}"
                           TextColor="{StaticResource TextMuted}"
                           FontSize="14" />
                    <ActivityIndicator IsRunning="{Binding IsSyncing}" HeightRequest="22" />
                </VerticalStackLayout>
            </Border>

            <!-- Result -->
            <Border IsVisible="{Binding HasSyncResult}"
                    Style="{StaticResource DashboardCard}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                        <Label Text="Last Synchronization"
                               TextColor="{StaticResource TextPrimary}"
                               FontSize="16"
                               FontAttributes="Bold" />

                        <Border Grid.Column="1"
                                Style="{StaticResource DashboardBadge}"
                                BackgroundColor="{StaticResource PositiveBadgeBackground}">
                            <Label Text="{Binding LastSyncResult.Status}"
                                   TextColor="{StaticResource PositiveBadgeText}"
                                   FontSize="11"
                                   FontAttributes="Bold" />
                        </Border>
                    </Grid>

                    <Label Text="{Binding ResultSummaryText}"
                           TextColor="{StaticResource TextMuted}"
                           FontSize="13" />

                    <Border IsVisible="{Binding HasDataGap}"
                            BackgroundColor="{StaticResource WarningBackground}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            Padding="12">
                        <Label Text="Data gap detected: some older readings were overwritten on the ESP and are permanently lost."
                               TextColor="{StaticResource WarningText}"
                               FontSize="13" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Recent stored readings -->
            <Label Text="Recently Stored Readings"
                   TextColor="{StaticResource TextPrimary}"
                   FontSize="18"
                   FontAttributes="Bold"
                   IsVisible="{Binding RecentReadings.Count, Converter={StaticResource IsGreaterThanZeroConverter}}"
                   Margin="0,8,0,0" />

            <CollectionView ItemsSource="{Binding RecentReadings}"
                            IsVisible="{Binding RecentReadings.Count, Converter={StaticResource IsGreaterThanZeroConverter}}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:EspReadingView">
                        <Border BackgroundColor="{StaticResource CardBackground}"
                                Stroke="{StaticResource CardStroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="14"
                                Margin="0,0,0,10">
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="6" ColumnSpacing="12">
                                <Label Grid.Row="0"
                                       Text="{Binding DeviceId}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontSize="14"
                                       FontAttributes="Bold" />

                                <HorizontalStackLayout Grid.Column="1" Spacing="10">
                                    <Label Text="{Binding TemperatureCelsius, StringFormat='{0:F1}°C'}"
                                           TextColor="{StaticResource TemperatureAccent}"
                                           FontSize="13"
                                           FontAttributes="Bold" />
                                    <Label Text="{Binding HumidityPercent, StringFormat='{0:F1}%'}"
                                           TextColor="{StaticResource HumidityPurple}"
                                           FontSize="13"
                                           FontAttributes="Bold" />
                                </HorizontalStackLayout>

                                <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="16">
                                    <Label Text="{Binding RecordedAtLocal, StringFormat='{0:yyyy-MM-dd HH:mm:ss}'}"
                                           TextColor="{StaticResource TextMuted}"
                                           FontSize="11" />
                                    <Label Text="{Binding ReadingId, StringFormat='Reading {0}'}"
                                           TextColor="{StaticResource TextMuted}"
                                           FontSize="11" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
