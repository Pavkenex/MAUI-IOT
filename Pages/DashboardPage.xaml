<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUI_IOT.Pages.DashboardPage"
             BackgroundColor="{StaticResource AppBackground}"
             Title="Dashboard">
    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding LoadDashboardCommand}"
                 RefreshColor="{StaticResource GpsAccent}">
        <ScrollView>
            <VerticalStackLayout Padding="16,16,16,28" Spacing="16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="ESP Readings Dashboard" Style="{StaticResource PageTitleLabel}" />
                        <Label Text="{Binding LastUpdated}" Style="{StaticResource PageSubtitleLabel}" />
                    </VerticalStackLayout>

                    <Button Grid.Column="1"
                            Text="Refresh"
                            Command="{Binding LoadDashboardCommand}"
                            MinimumHeightRequest="44"
                            Padding="14,8"
                            VerticalOptions="Center" />
                </Grid>

                <!-- Storage Summary Card -->
                <Border Style="{StaticResource DashboardCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Local Storage Summary"
                               TextColor="{StaticResource TextPrimary}"
                               FontSize="16"
                               FontAttributes="Bold" />
                        <Label Text="{Binding ScanSummary}"
                               TextColor="{StaticResource TextMuted}"
                               FontSize="13" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="READINGS"
                                       Style="{StaticResource MetricTitleLabel}" />
                                <Label Text="{Binding TotalReadings}"
                                       TextColor="{StaticResource TemperatureAccent}"
                                       FontSize="20"
                                       FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="DEVICES"
                                       Style="{StaticResource MetricTitleLabel}" />
                                <Label Text="{Binding TotalDevices}"
                                       TextColor="{StaticResource HumidityAccent}"
                                       FontSize="20"
                                       FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                <Label Text="PENDING"
                                       Style="{StaticResource MetricTitleLabel}" />
                                <Label Text="{Binding PendingUploads}"
                                       TextColor="{StaticResource GpsAccent}"
                                       FontSize="20"
                                       FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   HeightRequest="22" />

                <Label Text="{Binding ErrorMessage}"
                       TextColor="DarkRed"
                       IsVisible="{Binding HasError}" />

                <!-- Latest ESP reading card -->
                <Border BackgroundColor="{StaticResource GpsCardBackground}"
                        Stroke="#B8CCE8"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="20">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                <Label Text="⌖"
                                       FontSize="28"
                                       TextColor="{StaticResource GpsAccent}"
                                       VerticalOptions="Center" />

                                <Label Text="Latest ESP Measurement"
                                       FontSize="22"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}"
                                       LineBreakMode="WordWrap" />
                            </HorizontalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                                <Label Text="DEVICE"
                                       Style="{StaticResource MetricTitleLabel}"
                                       HorizontalTextAlignment="End" />
                                <Label Text="{Binding LatestDeviceId}"
                                       TextColor="{StaticResource GpsAccent}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="End"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="TEMP" Style="{StaticResource MetricTitleLabel}" />
                                <Label Text="{Binding Temperature}"
                                       TextColor="{StaticResource TemperatureAccent}"
                                       FontSize="22"
                                       FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="HUMIDITY" Style="{StaticResource MetricTitleLabel}" />
                                <Label Text="{Binding Humidity}"
                                       TextColor="{StaticResource HumidityPurple}"
                                       FontSize="22"
                                       FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource DashboardCard}">
                    <VerticalStackLayout Spacing="16">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding TrendTitle}"
                                   TextColor="{StaticResource TextPrimary}"
                                   FontSize="22"
                                   FontAttributes="Bold" />

                            <Label Text="{Binding TrendSubtitle}"
                                   Style="{StaticResource PageSubtitleLabel}" />
                        </VerticalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <Border Style="{StaticResource DashboardBadge}"
                                    BackgroundColor="{StaticResource SoftBlue}">
                                <Label Text="{Binding SelectedTrendRange}"
                                       TextColor="{StaticResource TemperatureAccent}"
                                       FontSize="12"
                                       FontAttributes="Bold" />
                            </Border>

                            <Border Style="{StaticResource DashboardBadge}"
                                    BackgroundColor="{StaticResource SoftNeutral}">
                                <Label Text="7 points"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontSize="12"
                                       FontAttributes="Bold" />
                            </Border>
                        </HorizontalStackLayout>

                        <Border Stroke="{StaticResource TrendGridLine}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                HeightRequest="236"
                                Padding="12">
                            <Grid RowDefinitions="*,Auto" RowSpacing="12">
                                <Grid RowDefinitions="*,*,*,*" ColumnDefinitions="*,*,*,*,*,*,*">
                                    <BoxView Grid.Row="1" Grid.ColumnSpan="7" HeightRequest="1" BackgroundColor="{StaticResource TrendGridLine}" />
                                    <BoxView Grid.Row="2" Grid.ColumnSpan="7" HeightRequest="1" BackgroundColor="{StaticResource TrendGridLine}" />
                                    <BoxView Grid.Column="1" Grid.RowSpan="4" WidthRequest="1" BackgroundColor="{StaticResource TrendGridLine}" />
                                    <BoxView Grid.Column="2" Grid.RowSpan="4" WidthRequest="1" BackgroundColor="{StaticResource TrendGridLine}" />
                                    <BoxView Grid.Column="3" Grid.RowSpan="4" WidthRequest="1" BackgroundColor="{StaticResource TrendGridLine}" />
                                    <BoxView Grid.Column="4" Grid.RowSpan="4" WidthRequest="1" BackgroundColor="{StaticResource TrendGridLine}" />
                                    <BoxView Grid.Column="5" Grid.RowSpan="4" WidthRequest="1" BackgroundColor="{StaticResource TrendGridLine}" />

                                    <HorizontalStackLayout Grid.RowSpan="4"
                                                           Grid.ColumnSpan="7"
                                                           BindableLayout.ItemsSource="{Binding TrendBars}"
                                                           Spacing="6"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="End">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Grid RowDefinitions="*,Auto" RowSpacing="6" WidthRequest="30" HeightRequest="170">
                                                    <HorizontalStackLayout Spacing="3" HorizontalOptions="Center" VerticalOptions="End">
                                                        <BoxView WidthRequest="12"
                                                                 HeightRequest="{Binding TemperatureHeight}"
                                                                 CornerRadius="4,4,0,0"
                                                                 BackgroundColor="{StaticResource TemperatureAccent}"
                                                                 VerticalOptions="End" />

                                                        <BoxView WidthRequest="12"
                                                                 HeightRequest="{Binding HumidityHeight}"
                                                                 CornerRadius="4,4,0,0"
                                                                 BackgroundColor="{StaticResource HumidityPurple}"
                                                                 VerticalOptions="End" />
                                                    </HorizontalStackLayout>

                                                    <Label Grid.Row="1"
                                                           Text="{Binding Label}"
                                                           FontSize="9"
                                                           TextColor="{StaticResource TextMuted}"
                                                           HorizontalTextAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>
                                </Grid>

                                <Border Grid.Row="1"
                                        BackgroundColor="White"
                                        Stroke="#EEF0F5"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="10"
                                        HorizontalOptions="Center">
                                    <HorizontalStackLayout Spacing="16">
                                        <HorizontalStackLayout Spacing="7">
                                            <BoxView WidthRequest="12" HeightRequest="12" CornerRadius="2" BackgroundColor="{StaticResource TemperatureAccent}" />
                                            <VerticalStackLayout Spacing="0">
                                                <Label Text="TEMPERATURE" Style="{StaticResource MetricTitleLabel}" FontSize="10" />
                                                <Label Text="{Binding TrendTemperature}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                            </VerticalStackLayout>
                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout Spacing="7">
                                            <BoxView WidthRequest="12" HeightRequest="12" CornerRadius="2" BackgroundColor="{StaticResource HumidityPurple}" />
                                            <VerticalStackLayout Spacing="0">
                                                <Label Text="HUMIDITY" Style="{StaticResource MetricTitleLabel}" FontSize="10" />
                                                <Label Text="{Binding TrendHumidity}" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                            </VerticalStackLayout>
                                        </HorizontalStackLayout>
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
