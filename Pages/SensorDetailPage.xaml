<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MAUI_IOT.Models"
             xmlns:pageModels="clr-namespace:MAUI_IOT.PageModels"
             x:DataType="pageModels:SensorDetailPageModel"
             x:Class="MAUI_IOT.Pages.SensorDetailPage"
             BackgroundColor="{StaticResource AppBackground}"
             Title="Sensor details">
    <Grid MaximumWidthRequest="{OnIdiom Desktop=1400, Default=100000}"
          ColumnDefinitions="*,*"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="12"
          ColumnSpacing="16">

        <Grid Grid.Row="0"
              Grid.ColumnSpan="2"
              Padding="16,16,16,0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="12">
            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding Sensor.Name}"
                       Style="{StaticResource PageTitleLabel}" />
                <Label Text="Live readings"
                       Style="{StaticResource PageSubtitleLabel}" />
            </VerticalStackLayout>

            <Button Grid.Column="1"
                    Text="Refresh"
                    Command="{Binding LoadSensorCommand}"
                    MinimumHeightRequest="44"
                    Padding="14,8"
                    VerticalOptions="Center" />
        </Grid>

        <Grid Grid.Row="1"
              Grid.RowSpan="{OnIdiom Desktop=2, Default=1}"
              Grid.Column="0"
              Grid.ColumnSpan="{OnIdiom Desktop=1, Default=2}"
              RowDefinitions="*,Auto"
              RowSpacing="12">

            <Border BackgroundColor="White"
                    Stroke="#B8CCE8"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="0"
                    Margin="16,0,16,0"
                    MinimumHeightRequest="{OnIdiom Desktop=280, Default=200}">
                <Grid>
                    <WebView Source="{Binding MapSource}"
                             UserAgent="MauiIot/1.0"
                             IsVisible="{Binding HasMapLocation}" />

                    <VerticalStackLayout IsVisible="{Binding HasMapLocation, Converter={StaticResource InvertedBoolConverter}}"
                                         Spacing="8"
                                         VerticalOptions="Center"
                                         Padding="20">
                        <Label Text="No location for this reading"
                               TextColor="{StaticResource MapPlaceholder}"
                               FontSize="14"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Location is captured from this phone when readings are received from the ESP."
                               TextColor="{StaticResource TextMuted}"
                               FontSize="12"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Style="{StaticResource DashboardCard}"
                    Margin="16,0,16,16">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto"
                      RowSpacing="10" ColumnSpacing="14">
                    <Label Grid.Row="0"
                           Text="{Binding Sensor.Name}"
                           TextColor="{StaticResource TextPrimary}"
                           FontSize="18"
                           FontAttributes="Bold"
                           LineBreakMode="TailTruncation" />

                    <Border Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource DashboardBadge}"
                            BackgroundColor="{StaticResource PositiveBadgeBackground}"
                            HorizontalOptions="End"
                            VerticalOptions="Center">
                        <Label Text="Connected"
                               TextColor="{StaticResource PositiveBadgeText}"
                               FontSize="11"
                               FontAttributes="Bold" />
                    </Border>

                    <Border Grid.Row="1"
                            Style="{StaticResource DashboardBadge}"
                            BackgroundColor="{StaticResource SoftBlue}"
                            HorizontalOptions="Start">
                        <Label Text="{Binding Sensor.Type}"
                               TextColor="{StaticResource TemperatureAccent}"
                               FontSize="11"
                               FontAttributes="Bold" />
                    </Border>

                    <Label Grid.Row="2"
                           Text="{Binding Sensor.LatestReading}"
                           Style="{StaticResource MetricValueLabel}" />
                </Grid>
            </Border>
        </Grid>

        <RefreshView Grid.Row="{OnIdiom Desktop=1, Default=2}"
                     Grid.Column="{OnIdiom Desktop=1, Default=0}"
                     Grid.RowSpan="{OnIdiom Desktop=2, Default=1}"
                     Grid.ColumnSpan="{OnIdiom Desktop=1, Default=2}"
                     Margin="16,0,16,0"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadSensorCommand}"
                     RefreshColor="{StaticResource GpsAccent}">
            <CollectionView ItemsSource="{Binding Readings}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedReading}">
                <CollectionView.Header>
                    <VerticalStackLayout Spacing="12">
                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           HeightRequest="22" />

                        <Label Text="{Binding ErrorMessage}"
                               TextColor="DarkRed"
                               IsVisible="{Binding HasError}" />

                        <Label Text="Recent readings"
                               Style="{StaticResource PageTitleLabel}" />
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.EmptyView>
                    <Border IsVisible="{Binding IsEmpty}"
                            BackgroundColor="{StaticResource CardBackground}"
                            Stroke="{StaticResource CardStroke}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="32"
                            Margin="0,16,0,0"
                            HorizontalOptions="Center">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="--"
                                   FontSize="36"
                                   TextColor="{StaticResource TextMuted}"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="No readings available"
                                   FontSize="16"
                                   TextColor="{StaticResource TextMuted}"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Pull down or tap Refresh to try again"
                                   FontSize="13"
                                   TextColor="{StaticResource Gray300}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Reading">
                        <Border Style="{StaticResource SensorCard}"
                                Margin="0,0,0,12">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="Stroke" Value="{StaticResource TemperatureAccent}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                            <Setter Property="BackgroundColor" Value="{StaticResource SoftBlue}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto"
                                  RowSpacing="4"
                                  ColumnSpacing="14">
                                <Label Text="{Binding Value}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontSize="28"
                                       FontAttributes="Bold" />
                                <Label Grid.Column="1"
                                       Text="{Binding Timestamp, StringFormat='{0:HH:mm}'}"
                                       TextColor="{StaticResource TextMuted}"
                                       FontSize="14"
                                       VerticalOptions="Center" />
                                <Label Grid.Row="1"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding LocationText, StringFormat='Location: {0}'}"
                                       IsVisible="{Binding HasLocation}"
                                       TextColor="{StaticResource GpsAccent}"
                                       FontSize="12" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <BoxView HeightRequest="16" Color="Transparent" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
