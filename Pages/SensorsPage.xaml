<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MAUI_IOT.Models"
             xmlns:pageModels="clr-namespace:MAUI_IOT.PageModels"
             x:DataType="pageModels:SensorsPageModel"
             x:Class="MAUI_IOT.Pages.SensorsPage"
             BackgroundColor="{StaticResource AppBackground}"
             Title="Sensors">
    <RefreshView IsRefreshing="{Binding IsRefreshing}"
                 Command="{Binding LoadSensorsCommand}"
                 RefreshColor="{StaticResource GpsAccent}">
        <ScrollView>
            <VerticalStackLayout Padding="16,16,16,28" Spacing="16">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="IoT Sensors"
                               Style="{StaticResource PageTitleLabel}" />
                        <Label Text="{Binding LastUpdated}"
                               Style="{StaticResource PageSubtitleLabel}" />
                    </VerticalStackLayout>

                    <Button Grid.Column="1"
                            Text="Refresh"
                            Command="{Binding LoadSensorsCommand}"
                            MinimumHeightRequest="44"
                            Padding="14,8"
                            VerticalOptions="Center" />
                </Grid>

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   HeightRequest="22" />

                <Label Text="{Binding ErrorMessage}"
                       TextColor="DarkRed"
                       IsVisible="{Binding HasError}" />

                <Border IsVisible="{Binding IsEmpty}"
                        BackgroundColor="{StaticResource CardBackground}"
                        Stroke="{StaticResource CardStroke}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="32"
                        HorizontalOptions="Center">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="--"
                               FontSize="36"
                               TextColor="{StaticResource TextMuted}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="No sensors available"
                               FontSize="16"
                               TextColor="{StaticResource TextMuted}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Pull down or tap Refresh to try again"
                               FontSize="13"
                               TextColor="{StaticResource Gray300}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <CollectionView ItemsSource="{Binding Sensors}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:SensorSummary">
                            <Border Style="{StaticResource SensorCard}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenSensorCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="14">
                                    <Label Grid.Row="0"
                                           Text="{Binding Name}"
                                           TextColor="{StaticResource TextPrimary}"
                                           FontSize="18"
                                           FontAttributes="Bold" />

                                    <Border Grid.Row="1"
                                            Style="{StaticResource DashboardBadge}"
                                            BackgroundColor="{StaticResource SoftBlue}"
                                            HorizontalOptions="Start">
                                        <Label Text="{Binding Type}"
                                               TextColor="{StaticResource TemperatureAccent}"
                                               FontSize="11"
                                               FontAttributes="Bold" />
                                    </Border>

                                    <Label Grid.Row="2"
                                           Text="{Binding LatestReading}"
                                           TextColor="{StaticResource TextPrimary}"
                                           FontSize="28"
                                           FontAttributes="Bold" />

                                    <Border Grid.Row="3"
                                            Style="{StaticResource DashboardBadge}"
                                            BackgroundColor="{StaticResource PositiveBadgeBackground}"
                                            HorizontalOptions="Start">
                                        <Label Text="Connected"
                                               TextColor="{StaticResource PositiveBadgeText}"
                                               FontSize="11"
                                               FontAttributes="Bold" />
                                    </Border>

                                    <Label Grid.Row="0"
                                           Grid.Column="1"
                                           Text=">"
                                           TextColor="{StaticResource TextMuted}"
                                           FontSize="20"
                                           VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
