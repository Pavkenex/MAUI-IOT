<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MAUI_IOT.Models"
             xmlns:pageModels="clr-namespace:MAUI_IOT.PageModels"
             x:DataType="pageModels:ScanPageModel"
             x:Class="MAUI_IOT.Pages.ScanPage"
             BackgroundColor="{StaticResource AppBackground}"
             Title="Scan">
    <ScrollView>
        <VerticalStackLayout Padding="16,16,16,28" Spacing="16">
            <VerticalStackLayout Spacing="2">
                <Label Text="ESP Discovery"
                       Style="{StaticResource PageTitleLabel}" />
                <Label Text="Nearby ESP32 DHT22 loggers are discovered and synced automatically"
                       Style="{StaticResource PageSubtitleLabel}" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsScanning}"
                               IsVisible="{Binding IsScanning}"
                               HeightRequest="22" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="DarkRed"
                   IsVisible="{Binding HasError}" />

            <!-- Bluetooth Status Card -->
            <Border Style="{StaticResource DashboardCard}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                        <Label Text="Bluetooth"
                               TextColor="{StaticResource TextPrimary}"
                               FontSize="18"
                               FontAttributes="Bold" />

                        <Border Grid.Column="1"
                                Style="{StaticResource DashboardBadge}"
                                BackgroundColor="{StaticResource SoftBlue}">
                            <Label Text="{Binding BluetoothStatusText}"
                                   TextColor="{StaticResource TemperatureAccent}"
                                   FontSize="11"
                                   FontAttributes="Bold" />
                        </Border>
                    </Grid>

                    <Label Text="{Binding StatusMessage}"
                           TextColor="{StaticResource TextMuted}"
                           FontSize="14" />
                </VerticalStackLayout>
            </Border>

            <!-- Discovered devices -->
            <Label Text="Discovered ESP Devices"
                   TextColor="{StaticResource TextPrimary}"
                   FontSize="18"
                   FontAttributes="Bold"
                   IsVisible="{Binding HasDevices}"
                   Margin="0,8,0,0" />

            <CollectionView ItemsSource="{Binding Devices}"
                            IsVisible="{Binding HasDevices}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:EspDeviceRow">
                        <Border BackgroundColor="{StaticResource CardBackground}"
                                Stroke="{StaticResource CardStroke}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="14"
                                Margin="0,0,0,10">
                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8" ColumnSpacing="12">
                                <Label Grid.Row="0"
                                       Text="{Binding Name}"
                                       TextColor="{StaticResource TextPrimary}"
                                       FontSize="16"
                                       FontAttributes="Bold" />

                                <Border Grid.Row="0"
                                        Grid.Column="1"
                                        Style="{StaticResource DashboardBadge}"
                                        BackgroundColor="{StaticResource SoftNeutral}">
                                    <Label Text="{Binding Rssi, StringFormat='{0} dBm'}"
                                           TextColor="{StaticResource TextMuted}"
                                           FontSize="11"
                                           FontAttributes="Bold" />
                                </Border>

                                <Label Grid.Row="1"
                                       Grid.ColumnSpan="2"
                                       Text="{Binding Address}"
                                       TextColor="{StaticResource TextMuted}"
                                       FontSize="12" />

                                <Grid Grid.Row="2"
                                      Grid.ColumnSpan="2"
                                      ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                                    <Border Style="{StaticResource DashboardBadge}"
                                            BackgroundColor="{StaticResource SoftBlue}">
                                        <Label Text="{Binding AuthText}"
                                               TextColor="{StaticResource TemperatureAccent}"
                                               FontSize="11"
                                               FontAttributes="Bold" />
                                    </Border>

                                    <Border Grid.Column="1"
                                            Style="{StaticResource DashboardBadge}"
                                            BackgroundColor="{StaticResource SoftNeutral}">
                                        <Label Text="{Binding StatusText}"
                                               TextColor="{StaticResource TextMuted}"
                                               FontSize="11"
                                               FontAttributes="Bold" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
